# Normalize every text file to LF on all platforms: several verifiers hash
# committed bytes (build.rs asset pins, the SFace policy's source bindings), and
# Windows autocrlf checkouts were breaking them.
* text=auto eol=lf

# Bundled assets are hash-pinned by build.rs; git must never rewrite their
# bytes at all (auto-detection could reclassify a file as text).
assets/** -text

# Shell scripts must keep LF line endings wherever they are checked out.
*.sh text eol=lf
